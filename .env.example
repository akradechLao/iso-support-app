# ===========================================
# ISO Support App - Environment Variables
# ===========================================
#
# คัดลอกไฟล์นี้เป็น .env.local:
#   cp .env.example .env.local
#
# แก้ไขค่าตามต้องการ
#

# App Settings
NODE_ENV=production
PORT=3001

# App URL (แก้ไขตาม domain จริง)
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN.com

# API Settings (สำหรับอนาคต)
# API_URL=https://api.YOUR_DOMAIN.com

# Database (สำหรับอนาคต - เมื่อเชื่อมต่อ DB จริง)
# DATABASE_URL=postgresql://user:password@localhost:5432/iso_progress

# Authentication (สำหรับอนาคต)
# NEXTAUTH_URL=https://YOUR_DOMAIN.com
# NEXTAUTH_SECRET=your-secret-key-here

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_MOCK_DATA=true
ENABLE_ANALYTICS=false
